{
  "name": "bedrock-config-router",
  "version": "0.1.0",
  "description": "Config-driven Amazon Bedrock (Nova) router: AppConfig + Lambda response streaming behind API Gateway, built with CDK",
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "config:validate": "tsx scripts/validate.ts",
    "config:deploy": "tsx scripts/deploy-config.ts",
    "chat": "tsx scripts/chat.ts",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy"
  },
  "license": "MIT",
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-appconfig": "^3.1177.0",
    "@aws-sdk/client-cloudformation": "^3.1177.0",
    "@aws-sdk/credential-providers": "^3.1177.0",
    "@smithy/signature-v4": "^5.7.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.7",
    "ajv": "^8.20.0",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.37.0",
    "@aws-lambda-powertools/metrics": "^2.37.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1177.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
