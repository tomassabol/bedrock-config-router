{
  "defaultRoute": "chat",
  "routes": {
    "chat": {
      "description": "General assistant. A/B test: Nova 2 Lite (control) vs Nova Pro (treatment).",
      "systemPrompt": "You are a concise, helpful assistant.",
      "inference": { "maxTokens": 1024, "temperature": 0.5, "topP": 0.9 },
      "variants": [
        {
          "name": "control",
          "weight": 90,
          "models": ["eu.amazon.nova-2-lite-v1:0", "eu.amazon.nova-lite-v1:0", "eu.amazon.nova-micro-v1:0"]
        },
        {
          "name": "treatment-pro",
          "weight": 10,
          "models": ["eu.amazon.nova-pro-v1:0", "eu.amazon.nova-2-lite-v1:0"]
        }
      ]
    },
    "summarize": {
      "description": "Cheap, high-volume summarization.",
      "systemPrompt": "Summarize the user's text in at most five bullet points.",
      "inference": { "maxTokens": 512, "temperature": 0.2 },
      "variants": [
        {
          "name": "control",
          "weight": 100,
          "models": ["eu.amazon.nova-micro-v1:0", "eu.amazon.nova-lite-v1:0"]
        }
      ]
    },
    "reasoning": {
      "description": "Harder tasks routed to the strongest Nova models.",
      "systemPrompt": "Think step by step and give a clear final answer.",
      "inference": { "maxTokens": 2048, "temperature": 0.3 },
      "variants": [
        {
          "name": "control",
          "weight": 100,
          "models": ["eu.amazon.nova-pro-v1:0", "eu.amazon.nova-2-lite-v1:0"]
        }
      ]
    }
  }
}
